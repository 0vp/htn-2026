#!/usr/bin/env bash
set -euo pipefail
export OMP_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2
export PYTHONPATH="/opt/htn/esam/backend/src:/opt/htn/esam/fastsam"
exec /opt/htn/esam/env/bin/python -m htn_backend.perception.esam.runtime \
  --upstream /opt/htn/esam/upstream \
  --checkpoint /opt/htn/esam/weights/ESAM-E_online_epoch_128.pth \
  --fastsam /opt/htn/esam/weights/FastSAM-x.pt
